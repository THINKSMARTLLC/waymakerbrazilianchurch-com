# ============================================================
# Way Maker Church — Environment Variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` to git.
# ============================================================

# --- Supabase (Lovable Cloud) — public/browser-safe ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Supabase (server-side mirror used by SSR / server functions) ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# ============================================================
# The following are SERVER-ONLY secrets.
# DO NOT place real values in `.env` committed to the repo.
# Configure them in Lovable Cloud (Project → Secrets) for runtime,
# or in Workspace → Build Secrets if needed at build time.
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=...     # bypasses RLS — server only
# STRIPE_SECRET_KEY=sk_live_...     # Stripe server key
# STRIPE_WEBHOOK_SECRET=whsec_...   # Stripe webhook signing secret
# LOVABLE_API_KEY=...               # managed by Lovable
